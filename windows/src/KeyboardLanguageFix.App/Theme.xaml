<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="AccentColor">#2F6DF6</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Surface" Color="#F6F7F9" />
    <SolidColorBrush x:Key="Border" Color="#DFE3E8" />
    <SolidColorBrush x:Key="Muted" Color="#626B7A" />

    <sys:Double x:Key="FieldWidth">330</sys:Double>

    <Style TargetType="TextBlock" x:Key="Heading">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Hint">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style TargetType="TextBlock" x:Key="FieldLabel">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style TargetType="Border" x:Key="Card">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Width" Value="{StaticResource FieldWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinWidth" Value="88" />
    </Style>

</ResourceDictionary>
