<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>KeyboardLanguageFix</AssemblyName>
    <RootNamespace>KeyboardLanguageFix.App</RootNamespace>
    <Version>1.1.0</Version>
    <Product>Keyboard Language Fix</Product>
    <Authors>Mahmoud SATALEH</Authors>
    <Company>Mahmoud SATALEH</Company>
    <Copyright>Copyright (c) Mahmoud SATALEH</Copyright>
    <Description>Re-types text that was typed on the wrong keyboard layout.</Description>
    <!-- Lets the project compile on a non-Windows CI agent. Running still
         requires Windows; only the build is cross-platform. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010 asks for DPI to be set through ApplicationConfiguration, which
         belongs to WinForms-first apps. This one is WPF and only borrows
         WinForms for the tray icon, so app.manifest stays authoritative. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KeyboardLanguageFix.Core\KeyboardLanguageFix.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
