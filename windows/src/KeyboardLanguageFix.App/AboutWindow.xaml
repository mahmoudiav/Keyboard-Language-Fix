<Window x:Class="KeyboardLanguageFix.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Keyboard Language Fix"
        SizeToContent="Height"
        Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="Segoe UI"
        FontSize="13"
        FlowDirection="LeftToRight">

    <StackPanel Margin="24,22,24,18">

        <StackPanel Orientation="Horizontal">
            <Image x:Name="LogoImage" Width="48" Height="48" VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="ProductNameText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="TaglineText" TextWrapping="Wrap" Margin="0,16,0,0"
                   Foreground="{StaticResource Muted}" />

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock x:Name="CreditText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0">
                    <Hyperlink x:Name="EmailLink" RequestNavigate="OnNavigate">
                        <Run x:Name="EmailText" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock x:Name="PricingText" Margin="0,10,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="LicenseText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}" FontSize="12" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   Text="Nothing you type or select is sent anywhere. Everything happens on this computer." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Copy details" Click="OnCopyDetails" />
            <Button Content="Close" Click="OnClose" Margin="8,0,0,0" IsDefault="True" IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
